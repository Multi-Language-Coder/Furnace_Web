+if (WEBPLAYER)
+  # Emit an ES6 module (furnace-web.js + furnace-web.wasm) that JS imports and
+  # drives via ccall/cwrap. Single-threaded: no -pthread, so no SharedArrayBuffer
+  # and no COOP/COEP headers are required to serve it.
+  set_target_properties(${FURNACE} PROPERTIES OUTPUT_NAME "furnace-web")
+  # The engine's file loader (DivEngine::load) uses C++ exceptions for control
+  # flow (NotZlibException); Emscripten disables exception catching by default,
+  # which turns those throws into aborts. Re-enable catching for the engine.
+  #
+  # -fno-strict-aliasing: the binary module parsers (loadFur etc.) reinterpret
+  # raw byte buffers through typed pointers. clang at -O3 (Emscripten's default)
+  # exploits strict aliasing and miscompiles those reads, so module loads fail
+  # (works at -O0 / under ASAN, fails at -O3). Disabling strict aliasing keeps
+  # -O3 performance while making the parsers correct.
+  target_compile_options(${FURNACE} PRIVATE "-fexceptions" "-fno-strict-aliasing")
+  target_link_options(${FURNACE} PRIVATE
+    "-fexceptions"
+    "-sUSE_SDL=2"
+    "-sMODULARIZE=1"
+    "-sEXPORT_ES6=1"
+    "-sEXPORT_NAME=FurnaceModule"
+    "-sENVIRONMENT=web,worker,node"
+    "-sALLOW_MEMORY_GROWTH=1"
+    "-sINITIAL_MEMORY=134217728"
+    # Emscripten's default stack is only 64 KB. The module loader (loadFur)
+    # places a large DivSong on the stack and recurses deep, overflowing it and
+    # silently corrupting memory (loads fail with garbage errors). Give it room.
+    "-sSTACK_SIZE=8388608"
+    "-sEXIT_RUNTIME=0"
+    "-sFORCE_FILESYSTEM=1"
+    # Keep the wasm a SEPARATE binary (not SINGLE_FILE): a big base64 .js ES
+    # module import gets reset by aggressive local HTTP scanners, whereas a plain
+    # .wasm binary fetch is retried/awaited by the browser (the full 15 MB GUI
+    # build loads this way). Small .js + separate .wasm is the robust path.
+    "-sEXPORTED_RUNTIME_METHODS=ccall,cwrap,HEAPU8,HEAPF32,UTF8ToString"
+    "-sEXPORTED_FUNCTIONS=_wp_init,_wp_load,_wp_play,_wp_stop,_wp_render,_wp_isPlaying,_wp_getOrder,_wp_getRow,_wp_getSongName,_wp_getSongAuthor,_wp_getLastError,_wp_getChannelCount,_wp_getChannelName,_wp_getChannelLevels,_wp_getChannelScope,_malloc,_free,_main"
+  )
+elseif (WEBGUI)
+  # Full tracker UI. Emscripten emits furnace.html (a shell with a <canvas>) plus
+  # furnace.js/.wasm. SDL2 (via -sUSE_SDL=2) creates the WebGL context and the
+  # SDL_Renderer/ImGui backend draws into it; the browser event loop drives
+  # FurnaceGUI::loopFrame() (see emscripten_set_main_loop in gui.cpp).
+  set_target_properties(${FURNACE} PROPERTIES OUTPUT_NAME "furnace" SUFFIX ".html")
