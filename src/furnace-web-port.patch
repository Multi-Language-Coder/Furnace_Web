+  # flow; no strict aliasing in the byte-buffer parsers).
+  target_compile_options(${FURNACE} PRIVATE "-fexceptions" "-fno-strict-aliasing")
+  target_link_options(${FURNACE} PRIVATE
+    "-fexceptions"
+    "-sUSE_SDL=2"
+    "-sMAX_WEBGL_VERSION=2"
