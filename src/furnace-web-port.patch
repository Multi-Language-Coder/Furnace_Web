+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <stdlib.h>
+
+// --- browser file bridge -------------------------------------------------
+// Open uses a hidden <input type=file>; the picked file is read into MEMFS at
+// /webopen/<name> and the C++ side polls furnaceWebPickState(). Save writes to
+// /websave/<name>; furnaceWebFlushDownloads() (called each frame) turns any file
+// there into a browser download. State lives on Module.__fur* to survive across
+// the async FileReader callback.
+
+// state: 0 = pending, 2 = ready, -1 = cancelled
+EM_JS(void, furnaceWebPickFile, (const char* acceptC), {
+  var accept = UTF8ToString(acceptC);
+  console.log('[FUR] pickFile accept=', accept);
+  Module.__furPickState = 0;
+  Module.__furPickPath = '';
+  try { FS.mkdir('/webopen'); } catch (e) {}
+  var input = document.createElement('input');
+  input.type = 'file';
+  if (accept) input.accept = accept;
+  input.style.display = 'none';
+  document.body.appendChild(input);
+  var picked = false;
+  function cleanup() {
+    if (input.parentNode) input.parentNode.removeChild(input);
+  }
+  input.addEventListener('change', function () {
+    console.log('[FUR] pickFile change, files=', input.files && input.files.length);
+    if (!input.files || !input.files.length) { Module.__furPickState = -1; cleanup(); return; }
+    picked = true;
+    var file = input.files[0];
+    var reader = new FileReader();
+    reader.onload = function () {
+      try {
+        FS.writeFile('/webopen/' + file.name, new Uint8Array(reader.result));
+        Module.__furPickPath = '/webopen/' + file.name;
+        Module.__furPickState = 2;
+        console.log('[FUR] pickFile wrote', Module.__furPickPath, reader.result.byteLength, 'bytes; state=2');
+      } catch (e) { console.error('[FUR] write failed', e); Module.__furPickState = -1; }
+      cleanup();
+    };
+    reader.onerror = function () { console.error('[FUR] FileReader error'); Module.__furPickState = -1; cleanup(); };
+    reader.readAsArrayBuffer(file);
+  });
+  // modern browsers fire 'cancel' when the picker is dismissed with no selection
+  input.addEventListener('cancel', function () {
+    console.log('[FUR] pickFile cancelled');
+    if (Module.__furPickState === 0) { Module.__furPickState = -1; cleanup(); }
+  });
+  input.click();
+});
+
+EM_JS(int, furnaceWebPickState, (), {
+  return Module.__furPickState | 0;
+});
+
+EM_JS(char*, furnaceWebPickPath, (), {
+  return stringToNewUTF8(Module.__furPickPath || '');
+});
+
+// download every file sitting in /websave, then remove it
+EM_JS(void, furnaceWebFlushDownloads, (), {
+  var dir = '/websave';
+  var list;
+  try { list = FS.readdir(dir); } catch (e) { return; }
+  list.forEach(function (name) {
+    if (name === '.' || name === '..') return;
+    var path = dir + '/' + name;
+    var data;
+    try { data = FS.readFile(path); } catch (e) { return; }
+    console.log('[FUR] downloading', name, data.length, 'bytes');
+    try {
+      var url = URL.createObjectURL(new Blob([data], { type: 'application/octet-stream' }));
+      var a = document.createElement('a');
+      a.href = url; a.download = name;
+      document.body.appendChild(a); a.click(); document.body.removeChild(a);
+      URL.revokeObjectURL(url);
+    } catch (e) { console.error('furnace: download failed', e); }
+    try { FS.unlink(path); } catch (e) {}
+  });
+});
+
+// called once per frame from the GUI loop to ship any pending save/export files
+void furnaceWebProcessDownloads() {
+  furnaceWebFlushDownloads();
+}
+#endif
